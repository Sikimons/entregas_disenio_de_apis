# Copia este archivo a backend/.env y completa tus propios valores.
# No se versiona (backend/.gitignore ya excluye .env).

# Base de datos
DB_HOST=localhost
DB_PORT=5432
DB_NAME=delivery_pin_middleware
DB_USERNAME=delivery_pin
DB_PASSWORD=change_me

# Autenticacion
JWT_SECRET=reemplaza_esto_por_un_secreto_propio_de_al_menos_32_caracteres
JWT_EXPIRATION_MINUTES=480
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me

# CORS (origenes del frontend, separados por coma)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Siembra de datos de muestra (dejar en false fuera de un entorno de pruebas)
APP_SEED_ENABLED=false
APP_SEED_FILE=file:/app/demo/invoices.json

# Costo por entrega verificada (showback, Fase1 §4.5) - 0 desactiva cada tarifa
APP_COST_INFRA_MONTHLY_USD=0
APP_COST_STORAGE_PER_GB_USD=0
APP_COST_SUPPORT_HOUR_USD=0

# Circuit Breaker (protege LocalInvoiceAdapter, la simulacion del ERP de Fase1 §3)
APP_CIRCUIT_BREAKER_ENABLED=true
APP_CIRCUIT_BREAKER_FAILURE_RATE=50
APP_CIRCUIT_BREAKER_WAIT_SECONDS=15
