# Secretos y variables para docker-compose.seed.yml (stack local con datos de muestra).
# Copia este archivo a ".env" en la misma carpeta y define tus propios valores:
#   cp .env.example .env
# ".env" no se comitea (ver .gitignore); estos son solo placeholders de ejemplo.

DB_NAME=delivery_pin_middleware
DB_USERNAME=delivery_pin
DB_PASSWORD=change_me_local_only

JWT_SECRET=change_me_at_least_32_characters_long_please

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_admin_password

# Opcional: tamano del pool de conexiones del backend (ver load-tests/README.md)
# DB_POOL_MAX_SIZE=10
