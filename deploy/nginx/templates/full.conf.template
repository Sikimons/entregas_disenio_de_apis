# Escenario B: backend y frontend en la misma VM, detras de este mismo nginx.
# /api -> backend; todo lo demas -> el frontend (que ya trae su propio nginx con el
# fallback de SPA y el proxy de /map-tiles, ver frontend/nginx.conf).

server {
    listen 80;
    server_name ${SERVER_NAME};
    location = /healthz { return 200 "ok"; add_header Content-Type text/plain; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    server_name ${SERVER_NAME};

    include /etc/nginx/snippets/cloudflare-realip.conf;
    include /etc/nginx/snippets/tls.conf;

    client_max_body_size 15M;

    location = /healthz {
        return 200 "ok";
        add_header Content-Type text/plain;
    }

    location /api/ {
        include /etc/nginx/snippets/proxy-headers.conf;
        proxy_pass http://backend:8080/api/;
    }

    location / {
        include /etc/nginx/snippets/proxy-headers.conf;
        proxy_pass http://frontend:80;
    }
}
