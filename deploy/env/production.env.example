# Copia a deploy/env/production.env y completa tus valores (no se versiona, ver .gitignore).
# Uso: docker compose -f deploy/docker-compose.yml --env-file deploy/env/production.env up -d

# --- Variables de Compose (topologia y nombres de imagen) ---
COMPOSE_PROJECT_NAME=ruta-delivery-prod
# APP_ENV_FILE debe apuntar a este mismo archivo (backend/seed lo leen via env_file).
APP_ENV_FILE=./env/production.env

# Por defecto la BD es AWS RDS (ver "Base de datos" abajo), asi que no hay profile "db".
# db          -> SOLO si quieres Postgres en contenedor en este mismo host en vez de RDS
#                (y entonces DB_HOST=postgres, DB_SSL_MODE=prefer)
# frontend    -> escenario B, sirve el frontend desde esta VM (quitalo si el frontend
#                vive en Cloudflare Pages, escenario A)
# seed        -> SOLO en el primer arranque para precargar datos de muestra;
#                nunca lo actives en produccion real
COMPOSE_PROFILES=

# api  -> escenario A (solo expone /api; el frontend esta en Cloudflare Pages)
# full -> escenario B (tambien sirve el frontend, requiere el profile "frontend")
NGINX_SITE=api

HTTP_PORT=80
HTTPS_PORT=443
CERTS_DIR=./certs

# Dominio publico del backend (o del sitio completo en escenario B). Debe coincidir con
# el "Common Name" del Origin Certificate de Cloudflare (deploy/nginx/snippets/tls.conf).
SERVER_NAME=api.midominio.com

BACKEND_IMAGE=ghcr.io/<owner>/ruta-backend
FRONTEND_IMAGE=ghcr.io/<owner>/ruta-frontend
# Tag desplegado: lo fija deploy/scripts/deploy.sh (desde CD o a mano) y tiene prioridad
# sobre este valor; aqui solo aplica si se corre "docker compose up" directamente. Usar
# siempre un tag inmutable (vX.Y.Z), nunca latest/staging.
BACKEND_TAG=v1.0.0
FRONTEND_TAG=v1.0.0

# --- Recursos de la VM ---
BACKEND_MEM_LIMIT=1g
# POSTGRES_MEM_LIMIT=512m   # solo con el profile "db"
LOG_MAX_SIZE=10m
LOG_MAX_FILE=5

# --- Respaldos (deploy/scripts/backup.sh; antes de cada despliegue y por cron) ---
# Solo aplican con el profile "db". Con RDS, backup.sh se omite: usa los snapshots
# automaticos de la instancia RDS.
# BACKUP_DIR=/opt/ruta/backups/production
BACKUP_RETENTION_DAYS=14
# Opcional: copia cada dump a S3 con el rol IAM de la instancia.
# BACKUP_S3_URI=s3://mi-bucket-respaldos/ruta

# --- Base de datos (AWS RDS PostgreSQL) ---
# Endpoint de la instancia RDS. Su security group debe permitir 5432 desde el SG de esta VM.
# Con profile "db" (Postgres local): DB_HOST=postgres, DB_SSL_MODE=prefer.
DB_HOST=<instancia>.<id>.<region>.rds.amazonaws.com
DB_PORT=5432
DB_NAME=delivery_pin_middleware
DB_USERNAME=delivery_pin
# Docker Compose interpola este archivo: si la contrasena contiene "$", ponla entre
# comillas simples (DB_PASSWORD='ab$cd').
DB_PASSWORD=change_me
# verify-full valida certificado y hostname con la CA de RDS incluida en la imagen del
# backend (backend/Dockerfile). "require" solo cifra, sin validar quien responde.
DB_SSL_MODE=verify-full
# DB_PUBLIC_PORT=127.0.0.1:5432   # solo con el profile "db"
DB_POOL_MAX_SIZE=10

# --- Autenticacion ---
JWT_SECRET=reemplaza_esto_por_un_secreto_propio_de_al_menos_32_caracteres
JWT_EXPIRATION_MINUTES=480
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me

# --- CORS y cookies ---
# Origen del frontend (Cloudflare Pages con dominio PROPIO, p. ej. app.midominio.com).
# Solo origenes exactos en produccion (admite patrones "https://*.dominio", pero aqui
# no hace falta: las previews apuntan a staging).
CORS_ALLOWED_ORIGINS=https://app.midominio.com
# Dominio compartido por frontend y API (app.midominio.com / api.midominio.com). La cookie
# XSRF-TOKEN se emite para todo el dominio para que el JS del frontend pueda leerla; sin
# esto todo POST/PUT/DELETE despues del login responde 403. Con *.pages.dev NO funciona
# (dominios distintos: usa un dominio personalizado en Pages).
COOKIE_DOMAIN=midominio.com

# --- Datos de muestra ---
# El servicio "backend" siempre corre con esto en false (ver deploy/docker-compose.yml);
# esta variable solo la usa el servicio "seed" cuando el profile "seed" esta activo.
APP_SEED_FILE=file:/app/demo/invoices.json

# --- Rate limit de login ---
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# --- Costo por entrega verificada (showback, Fase1 §4.5) - 0 desactiva cada tarifa ---
APP_COST_INFRA_MONTHLY_USD=0
APP_COST_STORAGE_PER_GB_USD=0
APP_COST_SUPPORT_HOUR_USD=0

# --- Circuit Breaker / Retry (protegen LocalInvoiceAdapter, Fase1 §3 / Fase8) ---
APP_CIRCUIT_BREAKER_ENABLED=true
APP_CIRCUIT_BREAKER_FAILURE_RATE=50
APP_CIRCUIT_BREAKER_WAIT_SECONDS=15
APP_RETRY_ENABLED=true
APP_RETRY_MAX_ATTEMPTS=3
APP_RETRY_WAIT_MILLIS=200

# --- Cache Aside (Fase8) ---
APP_CACHE_INVOICE_LINES_TTL_SECONDS=300
APP_CACHE_EXPECTED_LOCATION_TTL_SECONDS=300
APP_CACHE_MAX_ENTRIES=2000
