# Copia a deploy/env/production-full.env y completa tus valores (no se versiona, ver
# .gitignore). Variante de production.env.example para el ESCENARIO B: backend, Postgres,
# nginx Y el frontend en la misma VM (sin Cloudflare Pages). Usa esta version solo si de
# verdad quieres esa topologia; para el escenario habitual (frontend en Cloudflare Pages)
# usa production.env.example.
# Uso: docker compose -f deploy/docker-compose.yml --env-file deploy/env/production-full.env up -d

# --- Variables de Compose (topologia y nombres de imagen) ---
COMPOSE_PROJECT_NAME=ruta-delivery-prod
# APP_ENV_FILE debe apuntar a este mismo archivo (backend/seed lo leen via env_file).
APP_ENV_FILE=./env/production-full.env

# db          -> levanta postgres en este mismo host (quitalo si usas una BD externa,
#                p. ej. RDS, y define DB_HOST/DB_PASSWORD apuntando a ella)
# frontend    -> escenario B: sirve el frontend desde esta VM (requiere FRONTEND_IMAGE
#                mas abajo y NGINX_SITE=full)
# seed        -> SOLO en el primer arranque para precargar datos de muestra;
#                nunca lo actives en produccion real
COMPOSE_PROFILES=db,frontend

# full -> escenario B: nginx sirve tambien el frontend (no solo /api)
NGINX_SITE=full

HTTP_PORT=80
HTTPS_PORT=443
CERTS_DIR=./certs

# Dominio publico del sitio completo (backend + frontend). Debe coincidir con el
# "Common Name" del Origin Certificate de Cloudflare (deploy/nginx/snippets/tls.conf).
SERVER_NAME=midominio.com

BACKEND_IMAGE=ghcr.io/<owner>/ruta-backend
FRONTEND_IMAGE=ghcr.io/<owner>/ruta-frontend
# Tag desplegado: lo fija deploy/scripts/deploy.sh (desde CD o a mano) y tiene prioridad
# sobre este valor; aqui solo aplica si se corre "docker compose up" directamente. Usar
# siempre un tag inmutable (vX.Y.Z), nunca latest/staging.
BACKEND_TAG=v1.0.0
FRONTEND_TAG=v1.0.0

# --- Recursos de la VM ---
BACKEND_MEM_LIMIT=1g
POSTGRES_MEM_LIMIT=512m
LOG_MAX_SIZE=10m
LOG_MAX_FILE=5

# --- Respaldos (deploy/scripts/backup.sh; antes de cada despliegue y por cron) ---
# BACKUP_DIR=/opt/ruta/backups/production
BACKUP_RETENTION_DAYS=14
# Opcional: copia cada dump a S3 con el rol IAM de la instancia.
# BACKUP_S3_URI=s3://mi-bucket-respaldos/ruta

# --- Base de datos ---
# Si quitas el profile "db" (BD externa, p. ej. RDS), cambia DB_HOST/DB_PORT a esa
# instancia y usa DB_SSL_MODE=verify-full (ver production.env.example).
DB_SSL_MODE=prefer
DB_HOST=postgres
DB_PORT=5432
DB_NAME=delivery_pin_middleware
DB_USERNAME=delivery_pin
DB_PASSWORD=change_me
DB_PUBLIC_PORT=127.0.0.1:5432
DB_POOL_MAX_SIZE=10

# --- Autenticacion ---
JWT_SECRET=reemplaza_esto_por_un_secreto_propio_de_al_menos_32_caracteres
JWT_EXPIRATION_MINUTES=480
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me

# --- CORS ---
# Escenario B: todo se sirve por el mismo origen (SERVER_NAME de arriba, https://), asi
# que en la practica el backend solo ve peticiones same-origin -- pero se deja explicito
# igual, por si se agrega otro cliente mas adelante.
CORS_ALLOWED_ORIGINS=https://midominio.com

# --- Datos de muestra ---
# El servicio "backend" siempre corre con esto en false (ver deploy/docker-compose.yml);
# esta variable solo la usa el servicio "seed" cuando el profile "seed" esta activo.
APP_SEED_FILE=file:/app/demo/invoices.json

# --- Rate limit de login ---
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# --- Costo por entrega verificada (showback, Fase1 §4.5) - 0 desactiva cada tarifa ---
APP_COST_INFRA_MONTHLY_USD=0
APP_COST_STORAGE_PER_GB_USD=0
APP_COST_SUPPORT_HOUR_USD=0

# --- Circuit Breaker / Retry (protegen LocalInvoiceAdapter, Fase1 §3 / Fase8) ---
APP_CIRCUIT_BREAKER_ENABLED=true
APP_CIRCUIT_BREAKER_FAILURE_RATE=50
APP_CIRCUIT_BREAKER_WAIT_SECONDS=15
APP_RETRY_ENABLED=true
APP_RETRY_MAX_ATTEMPTS=3
APP_RETRY_WAIT_MILLIS=200

# --- Cache Aside (Fase8) ---
APP_CACHE_INVOICE_LINES_TTL_SECONDS=300
APP_CACHE_EXPECTED_LOCATION_TTL_SECONDS=300
APP_CACHE_MAX_ENTRIES=2000
