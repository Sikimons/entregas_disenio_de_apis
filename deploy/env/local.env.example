# Copia a deploy/env/local.env y completa tus valores (no se versiona, ver .gitignore).
# Uso (desde la raiz del repo):
#   docker compose -f deploy/docker-compose.yml --env-file deploy/env/local.env up -d --build --wait
# Todo queda en http://localhost:8080 (frontend en "/", API en "/api/"), un solo puerto,
# igual que en produccion. "--build" construye backend/frontend/seed desde ./backend y
# ./frontend en vez de bajarlos de GHCR (ver "build:" en deploy/docker-compose.yml).

# --- Variables de Compose (topologia y nombres de imagen) ---
COMPOSE_PROJECT_NAME=ruta-delivery-local
# APP_ENV_FILE debe apuntar a este mismo archivo (backend/seed lo leen via env_file).
APP_ENV_FILE=./env/local.env

# db       -> levanta postgres en este mismo host
# frontend -> sirve el frontend desde aqui (no hay Cloudflare Pages en local)
# seed     -> SOLO la primera vez, para precargar datos de muestra; quitalo despues
COMPOSE_PROFILES=db,frontend,seed

# Plantilla de nginx sin TLS ni redirect, pensada para este entorno (ver
# deploy/nginx/templates/local.conf.template).
NGINX_SITE=local

HTTP_PORT=8080
# Sin HTTPS_PORT: el template "local" no abre 443.
# CERTS_DIR tampoco aplica (no hay TLS en local).

SERVER_NAME=localhost

# Sin BACKEND_IMAGE/FRONTEND_IMAGE: caen al default "ruta-backend"/"ruta-frontend" (se
# construyen localmente con "--build", no se bajan de GHCR).
BACKEND_TAG=local
FRONTEND_TAG=local

# --- Recursos (valores por defecto de deploy/docker-compose.yml ya sirven en local) ---
# BACKEND_MEM_LIMIT=1g
# POSTGRES_MEM_LIMIT=512m

# --- Base de datos ---
DB_HOST=postgres
DB_PORT=5432
DB_NAME=delivery_pin_middleware
DB_USERNAME=delivery_pin
DB_PASSWORD=change_me_local_only
DB_PUBLIC_PORT=127.0.0.1:5433
DB_POOL_MAX_SIZE=10

# --- Autenticacion ---
JWT_SECRET=change_me_at_least_32_characters_long_please
JWT_EXPIRATION_MINUTES=480
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_admin_password

# --- CORS ---
# Todo se sirve por el mismo origen (nginx en :8080), pero el backend igual valida CORS.
CORS_ALLOWED_ORIGINS=http://localhost:8080

# --- Datos de muestra ---
# El servicio "backend" siempre corre con esto en false (ver deploy/docker-compose.yml);
# esta variable solo la usa el servicio "seed" cuando el profile "seed" esta activo.
APP_SEED_FILE=file:/app/demo/invoices.json

# --- Rate limit de login ---
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# --- Costo por entrega verificada (showback, Fase1 §4.5) - 0 desactiva cada tarifa ---
APP_COST_INFRA_MONTHLY_USD=0
APP_COST_STORAGE_PER_GB_USD=0
APP_COST_SUPPORT_HOUR_USD=0

# --- Circuit Breaker / Retry (protegen LocalInvoiceAdapter, Fase1 §3 / Fase8) ---
APP_CIRCUIT_BREAKER_ENABLED=true
APP_CIRCUIT_BREAKER_FAILURE_RATE=50
APP_CIRCUIT_BREAKER_WAIT_SECONDS=15
APP_RETRY_ENABLED=true
APP_RETRY_MAX_ATTEMPTS=3
APP_RETRY_WAIT_MILLIS=200

# --- Cache Aside (Fase8) ---
APP_CACHE_INVOICE_LINES_TTL_SECONDS=300
APP_CACHE_EXPECTED_LOCATION_TTL_SECONDS=300
APP_CACHE_MAX_ENTRIES=2000
