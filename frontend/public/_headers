# Cabeceras de seguridad para Cloudflare Pages (escenario A: la SPA vive aqui, separada del
# backend). Mismo contenido que frontend/security-headers.conf, pero la CSP difiere en dos
# directivas porque aqui NO existen los proxies same-origin /api/ ni /map-tiles/ de
# frontend/nginx.conf: la API vive en otro origen (VITE_API_BASE_URL) y las teselas del mapa
# en el proveedor real (VITE_MAP_TILES_URL, obligatoria en Pages). __API_ORIGIN__/__TILES_ORIGIN__ los sustituye el
# paso de build en .github/workflows/ci.yml (preview por PR) y cd.yml (deploy-frontend) con
# los mismos valores que ya usa "pnpm run build"; si faltara sustituir alguno, ese paso falla
# antes de publicar (una CSP con el marcador literal bloquearia hasta el login).
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), camera=(self), microphone=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: __TILES_ORIGIN__; connect-src 'self' __API_ORIGIN__; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
