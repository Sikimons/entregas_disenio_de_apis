# Copia a load-tests/env/local.env. Reproduce los resultados documentados en el README
# contra el stack local (deploy/docker-compose.yml, deploy/env/local.env).
# Uso: load-tests/run.sh sustained load-tests/env/local.env
# Sin comillas en los valores (docker --env-file no las quita).

# k6 se une a la red de Docker Compose y le pega directo al backend (nginx no reenvia
# /v3/api-docs ni rutas fuera de /api/). El nombre sale de COMPOSE_PROJECT_NAME + "_default".
K6_DOCKER_NETWORK=ruta-delivery-local_default
BASE_URL=http://backend:8080
INSECURE_TLS=false

RUTA_ADMIN=admin
# ADMIN_PASSWORD de deploy/env/local.env
RUTA_PASSWORD=change_me_admin_password
RUTA_DRIVER=conductor
RUTA_DRIVER_PASSWORD=conductor123

LOAD_SCALE=1
P95_MS=
RUTA_CHECK_FIXTURES=1
