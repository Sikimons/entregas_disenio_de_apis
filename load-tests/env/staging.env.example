# Copia a load-tests/env/staging.env y completa tus valores (no se versiona, ver .gitignore).
# Uso: load-tests/run.sh smoke load-tests/env/staging.env
# IMPORTANTE: sin comillas en los valores (docker --env-file no las quita).

# --- Destino ---
# Opcion 1 (recomendada): dominio publico via Cloudflare, el camino real de los usuarios.
BASE_URL=https://api.staging.midominio.com
# Opcion 2: directo a la EC2, sin pasar por Cloudflare (evita sus limites/desafios con carga
# alta). Requiere abrir el security group de la EC2 en 443 a la IP de esta maquina, y como el
# Origin Certificate de Cloudflare no es publico, INSECURE_TLS=true.
# BASE_URL=https://<ip-o-dns-de-la-ec2>
INSECURE_TLS=false

# --- Credenciales del entorno (las mismas de deploy/env/staging.env en la EC2) ---
RUTA_ADMIN=admin
RUTA_PASSWORD=change_me
# Solo para "verify" (e2e): usuario conductor del entorno.
RUTA_DRIVER=conductor
RUTA_DRIVER_PASSWORD=conductor123

# --- Carga ---
# 1 = perfil documentado (150 VUs sostenidos, 750 en spike, hasta 10000 req/s en breakpoint).
# Empieza bajo (0.1-0.2) contra una EC2 pequena y sube de a poco.
LOAD_SCALE=0.2
# Vacio = cada escenario usa su umbral (500 ms; 1000 ms en spike). Sube si la latencia de red
# desde esta maquina es alta.
P95_MS=
# USER_AGENT=RutaLoadTest/1.0

# --- e2e (verify) ---
# 1 = comprueba los datos del seed demo (59 facturas / 50 PIN). Pon 0 si el entorno no se
# sembro con demo/invoices.json.
RUTA_CHECK_FIXTURES=1
